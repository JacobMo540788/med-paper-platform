# Database
DATABASE_URL="postgresql://meduser:medpass@localhost:5432/medpapers?schema=public"

# Redis
REDIS_URL="redis://localhost:6379"

# LLM (OpenRouter 兼容 OpenAI API 格式)
LLM_API_BASE="https://openrouter.ai/api/v1"
LLM_API_KEY="your-api-key-here"
LLM_MODEL="deepseek/deepseek-chat"

# PubMed (可选，提高速率限制)
NCBI_API_KEY=""

# Cron 安全密钥（调用 /api/cron/daily-fetch 时需携带）
CRON_SECRET="change-me-to-random-string"

# 站点 URL（SEO / sitemap）
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# 邮件订阅（预留 SMTP）
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""

# Telegram Bot（预留）
TELEGRAM_BOT_TOKEN=""
TELEGRAM_CHAT_ID=""

# 微信推送（预留）
WECHAT_WEBHOOK_URL=""
