generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Specialty {
  ONCOLOGY_COLORECTAL
  OPHTHALMOLOGY
  GASTROENTEROLOGY
  UROLOGY
  NEPHROLOGY
}

enum StudyType {
  BASIC
  CLINICAL
}

enum ArticleSource {
  PUBMED
  EUROPE_PMC
  CROSSREF
  SEED
}

enum ArticleVerificationStatus {
  PENDING
  VERIFIED
  FAILED
}

model Article {
  id              String        @id @default(cuid())
  titleEn         String        @map("title_en")
  titleCn         String?       @map("title_cn")
  abstract        String?       @db.Text
  abstractCn      String?       @map("abstract_cn") @db.Text
  journal         String
  impactFactor    Float         @map("impact_factor")
  jifStatus       String        @default("VERIFIED") @map("jif_status")
  jifYear         Int?          @map("jif_year")
  jifSource       String?       @map("jif_source")
  jifVerifiedAt   DateTime?     @map("jif_verified_at")
  doi             String?       @unique
  pmid            String?       @unique
  authors         String[]      @default([])
  firstAuthor     String?       @map("first_author")
  authorSortKey   String?       @map("author_sort_key")
  coFirstAuthors  String[]      @default([]) @map("co_first_authors")
  correspondingAuthors String[] @default([]) @map("corresponding_authors")
  publishDate     DateTime      @map("publish_date")
  year            Int?
  specialty       Specialty
  studyType       StudyType     @map("study_type")
  resourceKind    String        @default("CLINICAL_RESEARCH") @map("resource_kind")
  diseaseArea     String?       @map("disease_area")
  organization    String?
  organizationShortName String? @map("organization_short_name")
  versionYear     Int?          @map("version_year")
  guidelineType   String?       @map("guideline_type")
  officialUrl     String?       @map("official_url")
  researchDesign  String?       @map("research_design") @db.Text
  majorFindings   String?       @map("major_findings") @db.Text
  significance    String?       @db.Text
  keyPoints       Json?         @map("key_points")
  liuBenRole      String?       @map("liu_ben_role")
  inclusionEvidence String?     @map("inclusion_evidence") @db.Text
  dataSource      String?       @map("data_source")
  dataVerifiedAt  DateTime?     @map("data_verified_at")
  keywords        String[]      @default([])
  keywordsBilingual Json?       @map("keywords_bilingual")
  articleType     String?       @map("article_type")
  aiSummary       String?       @map("ai_summary")
  aiAnalysisJson  Json?         @map("ai_analysis_json")
  isLandmark      Boolean       @default(false) @map("is_landmark")
  isTodayPick     Boolean       @default(false) @map("is_today_pick")
  /** 北京时间日期键 YYYY-MM-DD，标记为当日首页推荐 */
  featuredDateKey String?       @map("featured_date_key")
  lastRecommendedAt DateTime?   @map("last_recommended_at")
  recommendCount    Int         @default(0) @map("recommend_count")
  recommendSource   String?     @map("recommend_source")
  isInHistory     Boolean       @default(false) @map("is_in_history")
  archivedAt      DateTime?     @map("archived_at")
  isCoreLibrary   Boolean       @default(false) @map("is_core_library")
  coreAddedAt     DateTime?     @map("core_added_at")
  source          ArticleSource @default(PUBMED)
  sourceProvider  String?       @map("source_provider")
  sourceUrl       String?       @map("source_url")
  verificationStatus ArticleVerificationStatus @default(PENDING) @map("verification_status")
  verificationError  String?    @map("verification_error") @db.Text
  lastVerifiedAt     DateTime?  @map("last_verified_at")
  pipelineStatus     String     @default("DISCOVERED") @map("pipeline_status")
  rawSource          String?    @map("raw_source")
  rawSourceUrl       String?    @map("raw_source_url")
  sourceRecordId     String?    @map("source_record_id")
  fetchedAt          DateTime?  @map("fetched_at")
  rawMetadataHash    String?    @map("raw_metadata_hash")
  validationTrail    Json?      @map("validation_trail")
  exclusionReasons   String[]   @default([]) @map("exclusion_reasons")
  aiModel            String?    @map("ai_model")
  aiPromptVersion    String?    @map("ai_prompt_version")
  contentReviewedAt  DateTime?  @map("content_reviewed_at")
  publishedAt        DateTime?  @map("published_at")
  externalUrl     String?       @map("external_url")
  createdAt       DateTime      @default(now()) @map("created_at")
  updatedAt       DateTime      @updatedAt @map("updated_at")

  favorites Favorite[]
  dailyRecommendations DailyRecommendation[]

  @@index([specialty, publishDate])
  @@index([impactFactor])
  @@index([resourceKind])
  @@index([diseaseArea])
  @@index([year])
  @@index([jifStatus])
  @@index([authorSortKey])
  @@index([isTodayPick])
  @@index([featuredDateKey])
  @@index([lastRecommendedAt])
  @@index([recommendSource])
  @@index([isInHistory, specialty])
  @@index([isCoreLibrary, specialty])
  @@index([studyType])
  @@index([verificationStatus])
  @@index([pipelineStatus])
  @@index([sourceProvider, sourceRecordId])
  @@map("articles")
}

model DailyRecommendation {
  id                 String    @id @default(cuid())
  articleId          String    @map("article_id")
  article            Article   @relation(fields: [articleId], references: [id], onDelete: Cascade)
  recommendationDate DateTime  @map("recommendation_date")
  dateKey            String    @unique @map("date_key")
  specialty          Specialty
  recommendSource    String    @map("recommend_source")
  reason             String?   @db.Text
  score              Float?
  createdAt          DateTime  @default(now()) @map("created_at")

  @@index([articleId])
  @@index([specialty])
  @@index([recommendSource])
  @@map("daily_recommendations")
}

model User {
  id           String         @id @default(cuid())
  email        String         @unique
  name         String?
  createdAt    DateTime       @default(now()) @map("created_at")
  favorites    Favorite[]
  subscriptions Subscription[]

  @@map("users")
}

model Favorite {
  id        String   @id @default(cuid())
  userId    String   @map("user_id")
  articleId String   @map("article_id")
  createdAt DateTime @default(now()) @map("created_at")

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  article Article @relation(fields: [articleId], references: [id], onDelete: Cascade)

  @@unique([userId, articleId])
  @@map("favorites")
}

model Subscription {
  id         String      @id @default(cuid())
  userId     String      @map("user_id")
  specialty  Specialty?
  email      String
  active     Boolean     @default(true)
  createdAt  DateTime    @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("subscriptions")
}

model FetchLog {
  id          String   @id @default(cuid())
  runAt       DateTime @default(now()) @map("run_at")
  specialty   Specialty?
  fetched     Int      @default(0)
  accepted    Int      @default(0)
  fallback    Int      @default(0)
  errors      String?  @db.Text
  durationMs  Int      @map("duration_ms")

  @@map("fetch_logs")
}

model JournalIf {
  id            String  @id @default(cuid())
  journalName   String  @unique @map("journal_name")
  normalizedName String? @map("normalized_name")
  issn          String?
  eIssn         String? @map("e_issn")
  aliases       String[] @default([])
  impactFactor  Float   @map("impact_factor")
  jifYear       Int?    @map("jif_year")
  source        String?
  verifiedAt    DateTime? @map("verified_at")
  tier          Int     @default(1)
  isTopJournal  Boolean @default(false) @map("is_top_journal")
  updatedAt     DateTime @updatedAt @map("updated_at")

  @@index([normalizedName])
  @@index([issn])
  @@index([eIssn])
  @@map("journal_ifs")
}

model HarvestRun {
  id                    String   @id @default(cuid())
  runKey                String   @unique @map("run_key")
  mode                  String
  status                String
  startedAt             DateTime @default(now()) @map("started_at")
  endedAt               DateTime? @map("ended_at")
  fromDate              DateTime? @map("from_date")
  toDate                DateTime? @map("to_date")
  totalHits             Int      @default(0) @map("total_hits")
  discovered            Int      @default(0)
  dedupedCandidates     Int      @default(0) @map("deduped_candidates")
  metadataVerified      Int      @default(0) @map("metadata_verified")
  contentReviewed       Int      @default(0) @map("content_reviewed")
  jifVerified           Int      @default(0) @map("jif_verified")
  published             Int      @default(0)
  manualReview          Int      @default(0) @map("manual_review")
  rejected              Int      @default(0)
  sourceErrors          Int      @default(0) @map("source_errors")
  report                Json?
  errors                String?  @db.Text
  createdAt             DateTime @default(now()) @map("created_at")
  updatedAt             DateTime @updatedAt @map("updated_at")

  @@index([mode, status])
  @@index([startedAt])
  @@map("harvest_runs")
}

model HarvestCheckpoint {
  id              String   @id @default(cuid())
  key             String   @unique
  value           String
  updatedAt       DateTime @updatedAt @map("updated_at")

  @@map("harvest_checkpoints")
}

model JobLock {
  id           String   @id @default(cuid())
  key          String   @unique
  owner        String
  lockedUntil  DateTime @map("locked_until")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  @@map("job_locks")
}
