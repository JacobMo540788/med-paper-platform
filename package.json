{
  "name": "med-paper-platform",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "dev:lan": "next dev -H 0.0.0.0",
    "dev:all": "concurrently -n web,worker -c blue,green \"npm run dev:lan\" \"npm run worker\"",
    "build": "next build",
    "build:full": "npx prisma generate && next build",
    "start": "next start",
    "start:lan": "next start -H 0.0.0.0 -p 3000",
    "pm2:start": "pm2 start ecosystem.config.cjs",
    "pm2:stop": "pm2 stop all",
    "pm2:status": "pm2 status",
    "lint": "next lint",
    "db:push": "npx prisma db push",
    "db:generate": "npx prisma generate",
    "db:migrate": "npx prisma migrate dev",
    "db:seed": "tsx scripts/seed-demo.ts",
    "worker": "tsx src/jobs/worker.ts"
  },
  "dependencies": {
    "@prisma/client": "^6.3.0",
    "@radix-ui/react-dropdown-menu": "^2.1.4",
    "@radix-ui/react-select": "^2.1.4",
    "@radix-ui/react-slot": "^1.1.1",
    "@radix-ui/react-tabs": "^1.1.2",
    "bullmq": "^5.34.5",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "fast-xml-parser": "^4.5.1",
    "framer-motion": "^11.15.0",
    "ioredis": "^5.4.2",
    "lucide-react": "^0.469.0",
    "mermaid": "^11.4.0",
    "next": "^15.1.3",
    "next-themes": "^0.4.4",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tailwind-merge": "^2.6.0",
    "tailwindcss-animate": "^1.0.7",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.5",
    "@types/react": "^19.0.2",
    "@types/react-dom": "^19.0.2",
    "autoprefixer": "^10.4.20",
    "concurrently": "^9.1.2",
    "pm2": "^5.4.3",
    "eslint": "^9.17.0",
    "eslint-config-next": "^15.1.3",
    "postcss": "^8.4.49",
    "prisma": "^6.3.0",
    "tailwindcss": "^3.4.17",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
